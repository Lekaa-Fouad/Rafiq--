# Rafiq Mobile App Environment Variables
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit the real .env to git.

# Backend API base URL
# - Android Emulator: http://10.0.2.2:8000
# - iOS Simulator:    http://localhost:8000
# - Physical device:  http://<YOUR_PC_LAN_IP>:8000  (e.g. http://192.168.1.5:8000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# API key matching the X-API-Key header required by the backend
EXPO_PUBLIC_API_KEY=123
